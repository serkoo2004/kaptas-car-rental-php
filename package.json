{
  "name": "fleetcore-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:public && next build",
    "build:public": "npm --prefix seko-deneme-front-main run build && node scripts/sync-public-frontend.cjs",
    "start": "node server.js",
    "lint": "eslint app components lib types tailwind.config.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:import-kaptas-vehicles": "node scripts/import-kaptas-vehicles.cjs",
    "db:setup": "prisma db push && prisma db seed",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mysql.ps1",
    "db:backup": "node scripts/database-backup.cjs",
    "db:check": "node scripts/check-data-integrity.cjs",
    "db:restore": "node scripts/database-restore.cjs",
    "test:account": "node scripts/test-account-flow.cjs",
    "test:db-constraints": "node scripts/test-database-constraints.cjs",
    "test:exchange-rates": "node --experimental-strip-types scripts/test-exchange-rates.mjs",
    "test:payment-security": "node --experimental-strip-types scripts/test-payment-security.mjs",
    "test:password-reset": "node --experimental-strip-types scripts/test-password-reset-security.mjs",
    "test:public-api": "node scripts/test-public-api.cjs",
    "test:reservation": "node scripts/test-reservation-concurrency.cjs",
    "prisma:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-slot": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "iyzipay": "^2.0.69",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
